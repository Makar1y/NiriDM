#!/bin/sh
# Mock `niri` for the smoke tests. Only the subcommands NiriDM uses are
# implemented; everything else returns `{"Ok":null}`.
#
# Environment:
#   NDM_MOCK_STATE       (file) outputs JSON for `msg --json outputs`
#   NDM_MOCK_WINDOWS     "mirror" => report a wl-mirror window
#   NDM_MOCK_WS          (file) name of the focused workspace
#   NDM_MOCK_EVENTS      (file) scripted event stream (see below)
#   NDM_MOCK_RELOAD      ok|fail|none => trailing ConfigLoaded behaviour
#   NDM_MOCK_ACTION_LOG  (file) actions are appended here
#
# Event script lines:
#   sleep N      wait N seconds
#   ws NAME      write NAME (empty to clear) to NDM_MOCK_WS
#   event JSON   emit the JSON object as one event line
case "$*" in
  "msg --json outputs") cat "${NDM_MOCK_STATE:?}" ;;

  "msg --json workspaces")
    if [ -n "${NDM_MOCK_WS:-}" ] && [ -s "$NDM_MOCK_WS" ]; then
      name=$(cat "$NDM_MOCK_WS")
      printf '%s\n' "[{\"id\":1,\"idx\":1,\"name\":\"$name\",\"output\":\"${NDM_MOCK_WS_OUTPUT:-DP-1}\",\"is_urgent\":false,\"is_active\":true,\"is_focused\":${NDM_MOCK_WS_FOCUSED:-true},\"active_window_id\":null}]"
    else
      printf '%s\n' '[]'
    fi ;;

  "msg --json windows")
    case "${NDM_MOCK_WINDOWS:-none}" in
      mirror)
        mw=${NDM_MOCK_MIRROR_W:-2880}; mh=${NDM_MOCK_MIRROR_H:-1800}
        printf '%s\n' "[{\"id\":42,\"title\":\"wl-mirror \\u2014 DP-1\",\"app_id\":\"wl-mirror\",\"pid\":9999,\"workspace_id\":1,\"is_focused\":false,\"layout\":{\"tile_size\":[$mw,$mh]}}]" ;;
      *) printf '%s\n' '[]' ;;
    esac ;;

  "msg --json event-stream")
    printf '{"WorkspacesChanged":{"workspaces":[]}}\n'
    printf '{"ConfigLoaded":{"failed":false}}\n'
    if [ -n "${NDM_MOCK_EVENTS:-}" ]; then
      while IFS= read -r line; do
        case "$line" in
          "" ) : ;;
          sleep\ *) sleep "${line#sleep }" ;;
          ws\ *)    printf '%s' "${line#ws }" > "${NDM_MOCK_WS:?}" ;;
          event\ *) printf '%s\n' "${line#event }" ;;
        esac
      done < "$NDM_MOCK_EVENTS"
    else
      case "${NDM_MOCK_RELOAD:-ok}" in
        ok)   sleep 0.3; printf '{"ConfigLoaded":{"failed":false}}\n' ;;
        fail) sleep 0.3; printf '{"ConfigLoaded":{"failed":true}}\n' ;;
        none) : ;;
      esac
    fi
    sleep 3600 ;;

  "msg action "*) echo "$*" >> "${NDM_MOCK_ACTION_LOG:-/dev/null}"; printf '{"Ok":null}\n' ;;
  *) printf '{"Ok":null}\n' ;;
esac
